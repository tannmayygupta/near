{
  "name": "quiet-treasury",
  "version": "1.0.0",
  "description": "DAO-voted private treasury execution on NEAR",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "verify": "tsx src/verify/cli.ts data/demo-run/proof-bundle.json && tsx src/verify/cli.ts data/demo-run/sealed-proof-bundle.json && tsx src/verify/cli.ts data/demo-run/custody-proof-bundle.json",
    "secret-scan": "tsx scripts/dev/secret-scan.ts",
    "worker": "tsx worker/index.ts",
    "dashboard": "npm --prefix app run dev",
    "e2e:real": "tsx --env-file=.env scripts/testnet/e2e-real.ts",
    "e2e:custody": "tsx --env-file=.env scripts/testnet/e2e-custody.ts",
    "e2e:sealed": "tsx --env-file=.env scripts/testnet/e2e-sealed.ts",
    "e2e:restart": "tsx --env-file=.env scripts/testnet/e2e-restart.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "near-api-js": "7.5.3",
    "openai": "7.55.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
