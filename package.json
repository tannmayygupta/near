{
  "name": "quiet-treasury",
  "version": "1.0.0",
  "description": "DAO-voted private treasury execution on NEAR",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "demo": "tsx scripts/demo/offline-story.ts",
    "verify": "tsx src/verify/cli.ts data/demo-run/proof-bundle.json && tsx src/verify/cli.ts data/demo-run/sealed-proof-bundle.json && tsx src/verify/cli.ts data/demo-run/custody-proof-bundle.json",
    "secret-scan": "tsx scripts/dev/secret-scan.ts",
    "check:evidence": "tsx scripts/dev/check-evidence.ts",
    "verify:contract": "tsx scripts/dev/verify-contract-hash.ts",
    "verify:mainnet": "tsx src/verify/cli.ts data/demo-run/mainnet-proof-bundle.json",
    "mainnet:preflight": "tsx --env-file=.env scripts/mainnet/preflight.ts",
    "mainnet:verify": "tsx --env-file=.env scripts/mainnet/verify.ts",
    "mainnet:test": "tsx --env-file=.env scripts/mainnet/test-contract.ts",
    "contract:methods": "tsx scripts/dev/contract-methods.ts",
    "mainnet:setup":"tsx --env-file=.env scripts/mainnet/setup.ts",
    "mainnet:e2e": "tsx --env-file=.env scripts/mainnet/e2e-mainnet.ts",
    "mainnet:lock": "tsx --env-file=.env scripts/mainnet/lock-contract.ts",
    "alert:test": "tsx scripts/dev/alert-test.ts",
    "fund:check": "tsx scripts/dev/fund-check.ts",
    "build:contract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-contract.ps1",
    "worker": "tsx worker/index.ts",
    "dashboard": "npm --prefix app run dev",
    "e2e:real": "tsx --env-file=.env scripts/testnet/e2e-real.ts",
    "e2e:custody": "tsx --env-file=.env scripts/testnet/e2e-custody.ts",
    "e2e:sealed": "tsx --env-file=.env scripts/testnet/e2e-sealed.ts",
    "e2e:restart": "tsx --env-file=.env scripts/testnet/e2e-restart.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "near-api-js": "7.5.3",
    "openai": "7.55.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
