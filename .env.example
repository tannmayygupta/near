# Never commit real values. Copy to .env and fill locally.
# The worker validates this file's variables at startup (worker/config.ts) and refuses to start on any problem, listing ALL of them.
# REQUIRED: DAO_ACCOUNT, MANDATE_CONTRACT, AGENT_ACCOUNT_ID, AGENT_SECRET_KEY, plus the ones each EXEC_MODE needs (noted below). Everything else is optional.
# Generate SEALED_TERMS_KEY with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  (losing it loses sealed terms stored by the worker).
NEAR_AI_API_KEY=
OUTLAYER_WK=
NEAR_NETWORK=testnet
DAO_ACCOUNT=
MANDATE_CONTRACT=
SEALED_TERMS_KEY=

# ---- worker (see worker/README.md) ----
# EXEC_MODE=live is the default and is UNPROVEN with real money. EXEC_MODE=simulated = testnet adapter (fills are NOT trades, tagged 'simulated').
EXEC_MODE=live
SIM_QUOTE_RECIPIENT=
SIM_AUTOFUND=0
AGENT_ACCOUNT_ID=
AGENT_SECRET_KEY=
# EXEC_MODE=testnet-real needs VAULT_ACCOUNT_ID + VAULT_SECRET_KEY + SIM_QUOTE_RECIPIENT; EXEC_MODE=testnet-outlayer needs CUSTODY_SEED + SIM_QUOTE_RECIPIENT; EXEC_MODE=live needs OUTLAYER_WK.
VAULT_ACCOUNT_ID=
VAULT_SECRET_KEY=
# OutLayer custody (EXEC_MODE=testnet-outlayer): the wallet is deterministic for (owner account, seed). AGENT_SECRET_KEY should be a FUNCTION-CALL key limited to the mandate contract's
# 5 agent methods (scripts/testnet/scoped-key.ts); writing a wallet policy needs a deposit, so the wallet OWNER credential is separate:
CUSTODY_SEED=
CUSTODY_OWNER_KEY=
CUSTODY_POLICIES=data/custody-policies.json
# 1 = refuse to start unless AGENT_SECRET_KEY is a scoped function-call key (otherwise a full-access key only logs agent_key_scope_warning)
REQUIRE_SCOPED_KEY=0
# mainnet is refused unless ALLOW_MAINNET=1 (this build has never run on mainnet) and SEALED_TERMS_KEY is set
ALLOW_MAINNET=0
# optional Layer-A (OutLayer wallet policy) red-team probe, testnet
LAYER_A_SEED=
LAYER_A_OWNER_ACCOUNT=
LAYER_A_OWNER_KEY=
LAYER_A_ALLOWED=

# worker runtime (all optional; defaults shown)
PORT=8787
TICK_MS=5000
STATE_DB=data/worker.sqlite
# ignore mandates below this id (a fresh state DB must not re-handle mandates an earlier worker already settled)
MANDATE_FROM_ID=0
WORKER_CORS_ORIGIN=*
# operator alerts (both or neither): stuck/failed/wallet-blocked events and the 5-minute monitor (MONITOR=0 turns the monitor off)
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT=
MONITOR=1
# public worker (docs/DEPLOY.md, "Hosted worker"): live attestation check (ATTESTATION=0 turns it off) and limits shared by all visitors (defaults shown)
# ATTESTATION=1
# ATTESTATION_MODEL=
# PARSE_PER_HOUR=60
# REDTEAM_CACHE_S=600
# REDTEAM_CHAIN_PER_HOUR=6
# REDTEAM_CHAIN_PER_DAY=30
# REDTEAM_WALLET_PER_HOUR=6
# only for EXEC_MODE=live (OutLayer API; default is the mainnet API)
OUTLAYER_BASE_URL=
# RPC overrides (public testnet RPC throttles polling: keep fastnear)
NEAR_TESTNET_RPC=https://test.rpc.fastnear.com
NEAR_MAINNET_RPC=https://rpc.mainnet.fastnear.com
SANDBOX_RPC=http://localhost:3030
# allowed-token profile: testnet|mainnet (default follows NEAR_NETWORK)
TOKEN_PROFILE=
# near.social publishing of mandate announcements / treasurer reputation (SOCIAL_PUBLISH=1 enables; defaults to the agent account)
SOCIAL_PUBLISH=0
SOCIAL_ACCOUNT_ID=
SOCIAL_ACCOUNT_KEY=

# ---- mainnet slice: one real NEAR Intents settlement (scripts/mainnet/intents-settle.ts, owner-run, real money) ----
# The OWNER's own funded mainnet account and its ed25519 secret key (read from the environment only; the script never prints or writes it).
# QT_FUNDER_ACCOUNT / QT_FUNDER_KEY (used by scripts/mainnet/setup.ts) are accepted as fallbacks.
MAINNET_FUNDER_ACCOUNT=
MAINNET_FUNDER_KEY=
# NEAR to swap (default 0.5, hard cap 1). A real run also needs ALLOW_MAINNET=1 and CONFIRM_INTENTS_SPEND=<the same amount>, set in the shell for that command only.
INTENTS_AMOUNT_NEAR=0.5
# optional 1Click partner JWT (sent as X-API-Key); without it 1Click adds 0.25%
ONECLICK_JWT=
# only to continue a PARKED run (deposit sent, result not recorded): the deposit tx hash you found on nearblocks
INTENTS_DEPOSIT_TX=

# ---- dashboard (app/.env.local) ----
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com
NEXT_PUBLIC_DAO=
NEXT_PUBLIC_DAO_ACCOUNT=
NEXT_PUBLIC_MANDATE_CONTRACT=
NEXT_PUBLIC_AGENT_ACCOUNT=
NEXT_PUBLIC_WORKER_API=http://127.0.0.1:8787

