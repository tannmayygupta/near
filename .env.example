# Never commit real values. Copy to .env and fill locally.
NEAR_AI_API_KEY=
OUTLAYER_WK=
NEAR_NETWORK=testnet
DAO_ACCOUNT=
MANDATE_CONTRACT=
SEALED_TERMS_KEY=

# ---- worker (see worker/README.md) ----
# EXEC_MODE=live is the default and is UNPROVEN with real money. EXEC_MODE=simulated = testnet adapter (fills are NOT trades, tagged 'simulated').
EXEC_MODE=live
SIM_QUOTE_RECIPIENT=
SIM_AUTOFUND=0
AGENT_ACCOUNT_ID=
AGENT_SECRET_KEY=
# optional Layer-A (OutLayer wallet policy) red-team probe, testnet
LAYER_A_SEED=
LAYER_A_OWNER_ACCOUNT=
LAYER_A_OWNER_KEY=
LAYER_A_ALLOWED=

# ---- dashboard (app/.env.local) ----
NEXT_PUBLIC_NEAR_NETWORK=testnet
